# Fingerprinted by the theme's Hugo pipeline (name.min.<sha256>.ext).
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed or mixed static assets.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
